    classDef app fill:#e8f6ef,stroke:#34845a,color:#102b1b
    classDef data fill:#fff2d8,stroke:#b8882c,color:#3c2a08
    classDef external fill:#f2eaff,stroke:#8463aa,color:#281c39
    class Client,Ops client
    class App,WS,Auth,Land,Analysis,Deal,Chat,AI,Admin app
    class DB,Redis,Files data
    class OAuth,Mail,Maps,OpenAI external
