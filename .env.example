# Database
MYSQL_DATABASE=heilous
DB_URL=jdbc:mysql://mysql:3306/heilous?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=heilous_user
DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=your_jwt_secret_key_must_be_at_least_32_characters_long

# Mail (Gmail SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# 로그인 성공 후 JWT 토큰을 전달할 프론트엔드 URL
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/callback

# Kakao REST API
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# File Upload
FILE_UPLOAD_DIR=uploads
